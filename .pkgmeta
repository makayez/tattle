package-as: Tattle

enable-nolib-creation: no

# Development-only files: the stub-client test harness and repo bookkeeping
# should never ship inside the packaged addon folder.
ignore:
  - Tests
  - Tools
  - CURSEFORGE.md
  - DESCRIPTION.md
  - FEATURES.md
  - PROJECT_SUMMARY.md
  - TESTING.md
  - UPDATES.md
  - .github
  - .gitignore
  # Repo-only art; the game loads the .tga, which does ship.
  - TattleTurtle.png
